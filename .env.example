# 럽유럽미 환경변수 예시
#
# 이 파일은 커밋되지만, 실제 값이 들어간 `.env.local`은 .gitignore로 제외된다.
# 실제 secret을 이 파일에 적지 않는다.

# ─────────────────────────────────────────────────────────────
# AI Analysis Pipeline (v1.6) — 서버 전용
# ─────────────────────────────────────────────────────────────
# ⚠️ NEXT_PUBLIC_ prefix를 붙이지 않는다. 붙이면 API Key가 클라이언트 번들에 포함된다.

# demo  = Provider를 부르지 않고 규칙 기반 결과를 돌려준다 (기본값)
# real  = 실제 Provider 호출. AI_API_KEY가 반드시 필요하다
# mock  = 개발 전용(v1.7). Provider를 부르지 않고 고정 응답으로 Narrative 배선을 확인한다.
#         검증 단계는 그대로 통과하며, 결과 meta.mode는 'mock'이라 real인 척하지 않는다.
#         Production(NODE_ENV=production)에서는 강제로 demo로 내려간다.
AI_MODE=demo

# OpenAI 호환 Chat Completions 엔드포인트를 사용한다 (SDK 의존성 없음)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# ⚠️ v1.10 — 사진 분석은 사진 **1장당 1회** 이 모델을 호출한다(사진 9장 = 9회).
# 사진 한 장씩 봐야 Provider가 '여러 장에서 반복됐다'를 스스로 주장하지 못한다(기능명세서 §3).
# 비용은 사진 수에 비례하므로 Vision 모델을 고를 때 이 점을 감안한다.
AI_VISION_MODEL=gpt-4o-mini

# 서버 측 Provider 타임아웃(ms)과 요청 본문 상한(bytes)
AI_TIMEOUT_MS=45000
AI_MAX_REQUEST_BYTES=12582912

# ─────────────────────────────────────────────────────────────
# 클라이언트 표시용 플래그
# ─────────────────────────────────────────────────────────────
# 실제 동작 모드는 서버(AI_MODE)가 결정한다. 아래 값은 첫 호출 이전 배지 표시용 힌트다.
# real 배포에서는 AI_MODE=real 과 함께 이 값도 real로 맞춘다.
NEXT_PUBLIC_AI_MODE=demo

# 개발용 AI 디버그 패널. NODE_ENV=production에서는 이 값이 true여도 강제로 숨긴다(v1.12 §52).
NEXT_PUBLIC_AI_DEBUG=false

# UT Mode (v1.7 구현) — true일 때만 지정 화면에 1~5 평가 UI가 붙는다.
#   S09 관찰 유사도 / S27R 근거 이해도 / F3 자기이해 도움 + 사진 가치
# ⚠️ 이 점수는 분석 로직에 쓰지 않는다. Analytics 수집 전용이다.
NEXT_PUBLIC_UT_MODE=false

# ─────────────────────────────────────────────────────────────
# 기존 플래그
# ─────────────────────────────────────────────────────────────
# 사주 명식 계산 엔진 연결 여부 (미연결이면 사주 상세는 unavailable)
NEXT_PUBLIC_SAJU_ENGINE_READY=false

# Premium Fake Door (실제 결제 없음)
# v1.15부터 A/B 두 variant 모두 ₩1,900을 가리킨다(MVP 단일 가격 HYPOTHESIS) — 이 값은
# 어느 variant로 고정할지만 결정할 뿐, 사용자가 실제로 다른 가격을 보는 일은 없다.
NEXT_PUBLIC_PREMIUM_FAKE_DOOR=true
NEXT_PUBLIC_PREMIUM_VARIANT=A
NEXT_PUBLIC_PREMIUM_PREVIEW=false
# 가격을 직접 고정해서 보고 싶을 때만 사용(있으면 variant 테이블보다 우선). 기본은 비워둔다.
NEXT_PUBLIC_PREMIUM_TEST_PRICE=

# GA4 연결 (v1.10 도입, v1.12에서 실제 로딩 연결). 값이 없으면 analytics는 local store에만
# 남고 외부로는 나가지 않는다. 값이 있어도 ① production 빌드이고 ② 사용자가 Consent
# 배너에서 동의(granted)해야만 실제로 gtag.js가 로드된다(`src/components/shell/GaScriptLoader.tsx`,
# 기능명세서 §14).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────
# Shared Rate Limit (v1.12 §29~§31) — 서버 전용
# ─────────────────────────────────────────────────────────────
# 현재 AI API Route의 rate limit(`src/app/api/ai/_shared.ts`)은 인스턴스 메모리 기반이라
# 서버리스 다중 인스턴스에서는 정확하지 않다. 이 값이 비어 있으면 항상 Memory로 fallback한다
# — 이 프로젝트에는 아직 실제로 연결할 공유 저장소(Redis/Upstash 등) credential이 없어서,
# 새 외부 dependency를 강제로 추가하지 않았다. 값을 채우려면 먼저 `RateLimitStore` 인터페이스의
# 실제 구현체를 연결해야 한다 — 지금은 값이 있어도 동작이 바뀌지 않는다(경계만 준비돼 있다).
SHARED_RATE_LIMIT_URL=
