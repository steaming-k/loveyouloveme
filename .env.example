# 럽유럽미 환경변수 예시
#
# 이 파일은 커밋되지만, 실제 값이 들어간 `.env.local`은 .gitignore로 제외된다.
# 실제 secret을 이 파일에 적지 않는다.

# ─────────────────────────────────────────────────────────────
# AI Analysis Pipeline (v1.6) — 서버 전용
# ─────────────────────────────────────────────────────────────
# ⚠️ NEXT_PUBLIC_ prefix를 붙이지 않는다. 붙이면 API Key가 클라이언트 번들에 포함된다.

# demo  = Provider를 부르지 않고 규칙 기반 결과를 돌려준다 (기본값)
# real  = 실제 Provider 호출. AI_API_KEY가 반드시 필요하다
# mock  = 개발 전용(v1.7). Provider를 부르지 않고 고정 응답으로 Narrative 배선을 확인한다.
#         검증 단계는 그대로 통과하며, 결과 meta.mode는 'mock'이라 real인 척하지 않는다.
#         Production(NODE_ENV=production)에서는 강제로 demo로 내려간다.
AI_MODE=demo

# OpenAI 호환 Chat Completions 엔드포인트를 사용한다 (SDK 의존성 없음)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# 서버 측 Provider 타임아웃(ms)과 요청 본문 상한(bytes)
AI_TIMEOUT_MS=45000
AI_MAX_REQUEST_BYTES=12582912

# ─────────────────────────────────────────────────────────────
# 클라이언트 표시용 플래그
# ─────────────────────────────────────────────────────────────
# 실제 동작 모드는 서버(AI_MODE)가 결정한다. 아래 값은 첫 호출 이전 배지 표시용 힌트다.
# real 배포에서는 AI_MODE=real 과 함께 이 값도 real로 맞춘다.
NEXT_PUBLIC_AI_MODE=demo
NEXT_PUBLIC_DEMO_AI=true

# 개발용: AI 디버그 패널 (v1.7에서도 UI 미구현 — 플래그만 존재)
NEXT_PUBLIC_AI_DEBUG=false

# UT Mode (v1.7 구현) — true일 때만 지정 화면에 1~5 평가 UI가 붙는다.
#   S09 관찰 유사도 / S28 근거 이해도 / F3 자기이해 도움 + 사진 가치
# ⚠️ 이 점수는 분석 로직에 쓰지 않는다. Analytics 수집 전용이다.
NEXT_PUBLIC_UT_MODE=false

# ─────────────────────────────────────────────────────────────
# 기존 플래그
# ─────────────────────────────────────────────────────────────
# 사주 명식 계산 엔진 연결 여부 (미연결이면 사주 상세는 unavailable)
NEXT_PUBLIC_SAJU_ENGINE_READY=false

# Premium Fake Door (실제 결제 없음)
NEXT_PUBLIC_PREMIUM_FAKE_DOOR=true
NEXT_PUBLIC_PREMIUM_VARIANT=A
NEXT_PUBLIC_PREMIUM_PREVIEW=false

# GA4 연결 (v1.10). 값이 없으면 analytics는 local store에만 남고 외부로는 나가지 않는다.
# 이 값이 있어도 gtag.js를 별도로 로딩하지 않으면(app/layout.tsx) 아무 효과가 없다 —
# 지금은 로딩하지 않으므로 값이 있어도 GA4 = NOT CONNECTED 상태다(기능명세서 §12.3).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
